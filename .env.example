# =============================================================================
# Лапометр - Переменные окружения
# =============================================================================
# Скопируйте этот файл в .env и заполните значения
# Copy this file to .env and fill in the values
# =============================================================================

# =============================================================================
# Supabase Configuration (ОБЯЗАТЕЛЬНО для облачного режима)
# =============================================================================
# Создайте проект на https://supabase.com
# Получите URL и anon key в Settings → API

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# =============================================================================
# Monitoring (ОПЦИОНАЛЬНО)
# =============================================================================

# Sentry DSN для отслеживания ошибок
# Получите на https://sentry.io
VITE_SENTRY_DSN=

# Plausible Analytics для приватной аналитики
# Получите домен на https://plausible.io
VITE_PLAUSIBLE_DOMAIN=

# =============================================================================
# Web Push Notifications (ОПЦИОНАЛЬНО)
# =============================================================================

# VAPID публичный ключ для Web Push
# Сгенерируйте с помощью: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# Supabase Functions URL для Web Push
# Получите в Supabase Dashboard → Settings → API
VITE_SUPABASE_FUNCTIONS_URL=

# =============================================================================
# CI/CD Configuration (для GitHub Actions)
# =============================================================================

# Платформа деплоя: cloudflare | netlify | docker
# Установите в GitHub → Settings → Secrets and variables → Actions → Variables
# DEPLOY_PLATFORM=cloudflare

# =============================================================================
# Cloudflare Pages (если DEPLOY_PLATFORM=cloudflare)
# =============================================================================
# Установите в GitHub → Settings → Secrets and variables → Actions → Secrets

# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# =============================================================================
# Netlify (если DEPLOY_PLATFORM=netlify)
# =============================================================================
# Установите в GitHub → Settings → Secrets and variables → Actions → Secrets

# NETLIFY_AUTH_TOKEN=
# NETLIFY_SITE_ID=

# =============================================================================
# Docker Hub (если DEPLOY_PLATFORM=docker)
# =============================================================================
# Установите в GitHub → Settings → Secrets and variables → Actions → Secrets

# DOCKERHUB_USERNAME=
# DOCKERHUB_TOKEN=

# =============================================================================
# Примечания / Notes
# =============================================================================
# 
# 1. Все переменные с префиксом VITE_ доступны в клиентском коде
#    All variables with VITE_ prefix are available in client code
#
# 2. Никогда не коммитьте файл .env в репозиторий
#    Never commit .env file to repository
#
# 3. Для локальной разработки создайте файл .env на основе .env.example
#    For local development create .env file based on .env.example
#
# 4. Для продакшена используйте переменные окружения платформы деплоя
#    For production use deployment platform environment variables
#
# 5. Supabase URL и anon key можно получить в Dashboard → Settings → API
#    Supabase URL and anon key can be obtained in Dashboard → Settings → API
#
# =============================================================================
